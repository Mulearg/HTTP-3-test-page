---
/**
 * The HTTP/3 landing page, rendered to static HTML at build time.
 *
 * Every component below is the SAME .tsx the SPA uses — imported from
 * ../../app/src, not copied. Astro runs them once during the build and emits
 * their markup into this file. None of them ship any JavaScript.
 *
 * Nav is the single exception. It owns the mega-menu open state, the hover
 * bridges and the mobile toggle, so it is hydrated as an island with
 * client:idle: its HTML is still in the document for crawlers, and its ~15kB
 * of behaviour attaches after the page is interactive rather than blocking it.
 */
import Base from '../layouts/Base.astro'

import { Nav } from '@app/sections/Nav'
import { Hero } from '@app/sections/Hero'
import { StatBand } from '@app/sections/StatBand'
import { WhyHttp3 } from '@app/sections/WhyHttp3'
import { Comparison } from '@app/sections/Comparison'
import { Protocols } from '@app/sections/Protocols'
import { HowYouConnect } from '@app/sections/HowYouConnect'
import { WhereItRuns } from '@app/sections/WhereItRuns'
import { Traps } from '@app/sections/Traps'
import { Proof } from '@app/sections/Proof'
import { ClosingCta } from '@app/sections/ClosingCta'
import { Footer } from '@app/sections/Footer'

const description =
  'HTTP/3 tunnelled through SOCKS5 UDP on the same gateway, port and credentials you already use. Live on Residential from two entry points.'
---

<Base
  title="HTTP/3 over QUIC, across 40M+ residential IPs | Rayobyte"
  shareTitle="HTTP/3 over QUIC, across 40M+ residential IPs"
  description={description}
  canonical="https://http-3-test-page.vercel.app/"
>
  <Nav client:idle />
  <main>
    <Hero />
    <StatBand />
    <WhyHttp3 />
    <Comparison />
    <Protocols />
    <HowYouConnect />
    <WhereItRuns />
    <Traps />
    <Proof />
    <ClosingCta />
  </main>
  <Footer />
</Base>
